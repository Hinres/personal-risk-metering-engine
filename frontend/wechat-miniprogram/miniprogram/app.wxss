/**app.wxss**/
/* 全局样式 */
page {
  --primary-color: #2c3e50;
  --secondary-color: #34495e;
  --accent-color: #3498db;
  --success-color: #27ae60;
  --warning-color: #f39c12;
  --danger-color: #e74c3c;
  --info-color: #17a2b8;
  
  --bg-primary: #f5f6fa;
  --bg-secondary: #ffffff;
  --bg-dark: #1a1a2e;
  
  --text-primary: #2c3e50;
  --text-secondary: #7f8c8d;
  --text-light: #bdc3c7;
  
  --border-color: #ecf0f1;
  --shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

/* 文字样式 */
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.text-secondary {
  color: var(--text-secondary);
  font-size: 26rpx;
}

.text-small {
  font-size: 24rpx;
  color: var(--text-light);
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.btn-primary {
  background: var(--primary-color);
  color: #ffffff;
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--primary-color);
  border: 2rpx solid var(--border-color);
}

.btn-danger {
  background: var(--danger-color);
  color: #ffffff;
}

/* 风险颜色 */
.risk-low {
  color: var(--success-color);
}

.risk-medium {
  color: var(--warning-color);
}

.risk-high {
  color: var(--danger-color);
}

.risk-critical {
  color: #c0392b;
  font-weight: bold;
}

/* 列表样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 60rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background: rgba(52, 152, 219, 0.1);
  color: var(--accent-color);
}

.tag-success {
  background: rgba(39, 174, 96, 0.1);
  color: var(--success-color);
}

.tag-warning {
  background: rgba(243, 156, 18, 0.1);
  color: var(--warning-color);
}

.tag-danger {
  background: rgba(231, 76, 60, 0.1);
  color: var(--danger-color);
}

/* 金额样式 */
.amount {
  font-family: 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
  font-variant-numeric: tabular-nums;
}

.amount-positive {
  color: var(--danger-color);
}

.amount-negative {
  color: var(--success-color);
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: var(--border-color);
  margin: 20rpx 0;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用数据展示卡片 */
.summary-card,
.history-card,
.preset-card,
.result-card,
.sector-row,
.snapshot-row {
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.summary-row,
.history-item,
.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.summary-row:last-child,
.history-item:last-child,
.result-row:last-child {
  border-bottom: none;
}

.summary-row .label,
.history-item .label,
.result-row .label {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.summary-row .value,
.history-item .value,
.result-row .value {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 500;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin: 30rpx 0 20rpx;
}

.empty {
  text-align: center;
  color: var(--text-secondary);
  padding: 60rpx 0;
  font-size: 28rpx;
}

.history-header,
.preset-header,
.snapshot-main,
.sector-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-date,
.snapshot-date,
.sector-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.history-method,
.snapshot-value,
.sector-return {
  font-size: 28rpx;
  color: var(--accent-color);
}

.history-body,
.preset-body,
.sector-meta,
.snapshot-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.preset-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.preset-delete {
  font-size: 26rpx;
  color: var(--danger-color);
}

.period-picker {
  font-size: 28rpx;
  color: var(--accent-color);
  padding: 8rpx 16rpx;
  background: rgba(52, 152, 219, 0.1);
  border-radius: 8rpx;
}

.holding-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.holding-row input {
  flex: 1;
  background: var(--bg-secondary);
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

.remove-btn {
  font-size: 26rpx;
  color: var(--danger-color);
  padding: 0 8rpx;
}

.picker {
  font-size: 28rpx;
  color: var(--text-primary);
  padding: 12rpx 0;
}

.form-item {
  margin-bottom: 20rpx;
}

.form-item .label {
  display: block;
  color: var(--text-secondary);
  font-size: 26rpx;
  margin-bottom: 8rpx;
}