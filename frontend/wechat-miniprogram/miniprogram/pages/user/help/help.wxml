<view class="container">
  <loading-spinner wx:if="{{loading}}" type="fullscreen" text="加载帮助内容..." />

  <block wx:if="{{!loading}}">
    <error-state wx:if="{{error}}" title="加载失败" desc="无法获取帮助内容" bind:retry="onRetry" />

    <view wx:else class="help-list">
      <!-- 视频教程入口 -->
      <view class="help-item card" bindtap="toggleVideoSection">
        <view class="help-header">
          <text class="help-title">🎬 视频教程</text>
          <text class="help-arrow {{videosExpanded ? 'expanded' : ''}}">›</text>
        </view>
        <view class="help-body {{videosExpanded ? 'expanded' : ''}}">
          <block wx:if="{{videos.length}}">
            <view class="video-item" wx:for="{{videos}}" wx:key="video_id" data-url="{{item.video_url}}" bindtap="openVideo">
              <text class="video-title">{{item.title}}</text>
              <text class="video-duration" wx:if="{{item.duration}}">{{item.duration}}</text>
            </view>
          </block>
          <text class="help-content" wx:else>暂无视频教程</text>
        </view>
      </view>

      <view class="help-item card" wx:for="{{categories}}" wx:key="title" data-index="{{index}}" bindtap="toggleExpand">
        <view class="help-header">
          <text class="help-title">{{item.title}}</text>
          <text class="help-arrow {{item.expanded ? 'expanded' : ''}}">›</text>
        </view>
        <view class="help-body {{item.expanded ? 'expanded' : ''}}">
          <text class="help-content">{{item.content}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
