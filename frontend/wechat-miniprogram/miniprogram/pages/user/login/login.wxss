.container { padding: 40rpx; background: #1a1a2e; min-height: 100vh; display: flex; flex-direction: column; justify-content: center; }
.form { background: #fff; border-radius: 16rpx; padding: 40rpx; }
.form-item { margin-bottom: 32rpx; }
.label { font-size: 28rpx; color: #2c3e50; display: block; margin-bottom: 8rpx; }
.input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; background: #fff; }
.btn-submit { background: #2c3e50; color: #fff; font-size: 30rpx; padding: 20rpx; border-radius: 8rpx; margin-bottom: 16rpx; }
.btn-wechat { background: #07c160; color: #fff; font-size: 30rpx; padding: 20rpx; border-radius: 8rpx; }
