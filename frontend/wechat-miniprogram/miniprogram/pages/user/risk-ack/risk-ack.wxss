.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 30rpx 30rpx 0;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 30rpx;
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

.risk-content {
  flex: 1;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.risk-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.8;
  white-space: pre-wrap;
}

.footer-actions {
  padding: 24rpx 0 40rpx;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border: 2rpx solid var(--border-color);
}

.btn-secondary::after {
  border: none;
}
