.container {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 30rpx;
  box-sizing: border-box;
  padding-bottom: 140rpx;
}

.card {
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  margin-bottom: 12rpx;
}

.intro-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.consent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.consent-item {
  display: flex;
  flex-direction: column;
}

.consent-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.consent-info {
  flex: 1;
  margin-right: 20rpx;
}

.consent-label {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.consent-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.consent-switch {
  transform: scale(0.85);
}

.consent-status {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

.status {
  font-size: 24rpx;
  font-weight: 500;
}

.status-on {
  color: var(--success-color);
}

.status-off {
  color: var(--text-secondary);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 30rpx 40rpx;
  background: var(--bg-primary);
}

.btn {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
}

.btn-primary::after {
  border: none;
}
