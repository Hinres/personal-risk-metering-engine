.container {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
}

.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 30rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--bg-secondary);
}

.avatar-default {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 64rpx;
  color: #fff;
  font-weight: bold;
}

.avatar-hint {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 16rpx;
  margin-bottom: 30rpx;
}

.nickname-row {
  width: 100%;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border: 2rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.nickname-label {
  font-size: 30rpx;
  color: var(--text-primary);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  min-height: 88rpx;
  font-size: 30rpx;
  color: var(--text-primary);
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-color);
  color: #fff;
  margin-bottom: 20rpx;
}

.btn-primary::after {
  border: none;
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.5;
}

.member-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.member-info {
  display: flex;
  flex-direction: column;
}

.member-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.member-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent-color);
}

.menu {
  padding: 0 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 2rpx solid var(--border-color);
  padding: 20rpx 0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item .label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-item .right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.badge {
  background: var(--danger-color);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 50%;
  min-width: 36rpx;
  text-align: center;
}

.arrow {
  font-size: 32rpx;
  color: var(--text-secondary);
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.info-card {
  padding: 0 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 2rpx solid var(--border-color);
  padding: 16rpx 0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  color: var(--text-primary);
}

.btn-logout {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--danger-color);
  color: #fff;
  margin-top: 40rpx;
}

.btn-logout::after {
  border: none;
}
