.container {
  min-height: 100vh;
  background: var(--bg-primary);
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 0 30rpx;
  box-shadow: var(--shadow);
  margin-bottom: 20rpx;
}

.form-card {
  padding: 0;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 100rpx;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.picker-value {
  font-size: 30rpx;
  color: var(--accent-color);
}

.action-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  min-height: 100rpx;
}

.action-text {
  font-size: 30rpx;
  color: var(--danger-color);
}

.arrow {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.btn {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
}

.btn-primary {
  background: var(--primary-color);
  color: #fff;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-primary::after {
  border: none;
}
