.container {
  padding: 20rpx;
  background: #f5f6fa;
  min-height: 100vh;
}
.header {
  padding: 20rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a2e;
}
.subtitle {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}
.upload-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  margin-top: 40rpx;
  border: 2rpx dashed #ccc;
}
.upload-icon {
  font-size: 80rpx;
  display: block;
}
.upload-text {
  font-size: 32rpx;
  color: #1a1a2e;
  margin-top: 20rpx;
  display: block;
}
.upload-hint {
  font-size: 24rpx;
  color: #7f8c8d;
  margin-top: 16rpx;
  display: block;
}
.loading {
  text-align: center;
  padding: 40rpx;
  color: #1a1a2e;
}
.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 24rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 16rpx;
}
.result-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}
.result-item:last-child { border-bottom: none; }
.success { color: #28a745; font-weight: bold; }
.error { color: #dc3545; font-weight: bold; }
/* F-02：三分支状态样式 */
.status-completed { color: #28a745; }
.status-partial { color: #e6a23c; }
.status-failed { color: #dc3545; }
.error-list {
  margin-top: 16rpx;
}
.error-item {
  font-size: 24rpx;
  color: #dc3545;
  padding: 8rpx 0;
}
.btn-back {
  margin-top: 40rpx;
  background: #1a1a2e;
  color: #fff;
  border-radius: 12rpx;
}
