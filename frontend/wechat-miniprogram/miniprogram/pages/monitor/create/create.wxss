.container {
  padding: 30rpx;
  background: #f5f6fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
  display: block;
}

.header-subtitle {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 12rpx;
  display: block;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.input, .picker {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fafafa;
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input:focus, .picker:focus {
  border-color: #2c3e50;
  background: #fff;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker::after {
  content: '▼';
  font-size: 20rpx;
  color: #7f8c8d;
}

.checkbox-label {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #2c3e50;
}

.checkbox-text {
  margin-left: 16rpx;
}

.btn-submit {
  background: #2c3e50;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(44,62,80,0.3);
  transition: transform 0.1s;
}

.btn-submit:active {
  transform: scale(0.98);
}

.btn-submit[disabled] {
  background: #bdc3c7;
  box-shadow: none;
}
