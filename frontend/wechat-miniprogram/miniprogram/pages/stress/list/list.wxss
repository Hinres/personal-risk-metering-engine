.container {
  padding: 20rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.top-action {
  margin-bottom: 24rpx;
}

.btn {
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #2c3e50;
  color: #fff;
}

button::after {
  border: none;
}

.list {
  height: calc(100vh - 168rpx);
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.name {
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
}

.date {
  font-size: 24rpx;
  color: #7f8c8d;
}

.card-body {
  display: flex;
  justify-content: space-between;
}

.metric {
  text-align: center;
  flex: 1;
}

.metric .label {
  font-size: 24rpx;
  color: #7f8c8d;
  display: block;
}

.metric .value {
  font-size: 28rpx;
  font-weight: bold;
  display: block;
  margin-top: 4rpx;
}
