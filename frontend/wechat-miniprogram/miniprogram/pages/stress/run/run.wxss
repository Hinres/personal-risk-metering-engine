.container {
  padding: 30rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.header {
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

.header-desc {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.picker, .input {
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  background: #fafafa;
  width: 100%;
  box-sizing: border-box;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker::after {
  content: '▼';
  font-size: 20rpx;
  color: #7f8c8d;
}

.custom-section {
  border-top: 2rpx solid #ecf0f1;
  padding-top: 24rpx;
  margin-top: 24rpx;
}

.custom-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.scenario-info {
  background: #f0f9ff;
  border: 2rpx solid #bae6fd;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.scenario-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0369a1;
  margin-bottom: 8rpx;
}

.scenario-desc {
  font-size: 24rpx;
  color: #0ea5e9;
  line-height: 1.5;
}

.btn-submit {
  background: #2c3e50;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(44,62,80,0.3);
}

.btn-submit:active {
  transform: scale(0.98);
}

.btn-submit[disabled] {
  background: #bdc3c7;
  box-shadow: none;
}
