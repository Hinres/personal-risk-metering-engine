.container {
  padding: 30rpx;
  background: var(--bg-primary);
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.header-right {
  position: relative;
  padding: 12rpx;
}

.bell {
  font-size: 40rpx;
}

.red-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger-color);
}

.portfolio-card {
  background: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
}

.portfolio-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.portfolio-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.portfolio-type {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: var(--bg-primary);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.portfolio-stats {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--bg-secondary);
  padding: 30rpx 40rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-btn text {
  font-size: 26rpx;
  color: var(--text-primary);
}
