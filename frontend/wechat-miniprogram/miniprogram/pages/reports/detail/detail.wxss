.container {
  padding: 20rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
}

.tag {
  font-size: 22rpx;
  color: #fff;
  background: #2c3e50;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.info {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.info-row .label {
  font-size: 28rpx;
  color: #7f8c8d;
}

.info-row .value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: bold;
}

.export-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #2c3e50;
  color: #fff;
}

.btn-secondary {
  background: #ecf0f1;
  color: #2c3e50;
}

button::after {
  border: none;
}
