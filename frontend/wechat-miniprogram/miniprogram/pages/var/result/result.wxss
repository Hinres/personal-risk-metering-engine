.container {
  padding: 30rpx;
  background: #f5f6fa;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
  margin-bottom: 30rpx;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.var-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #e74c3c;
  font-family: monospace;
}

.var-label {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 12rpx;
}

.var-percent {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.detail-card, .chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.detail-item:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: #7f8c8d;
}

.detail-value {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  gap: 20rpx;
  z-index: 100;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: #2c3e50;
  color: #fff;
}

.btn-secondary {
  background: #ecf0f1;
  color: #2c3e50;
}

button::after {
  border: none;
}
