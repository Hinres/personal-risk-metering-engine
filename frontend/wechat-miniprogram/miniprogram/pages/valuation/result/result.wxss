.container {
  padding: 30rpx;
  background: #f5f6fa;
  min-height: 100vh;
}

.stock-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stock-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

.stock-symbol {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 8rpx;
}

.method-picker {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.picker-value {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  color: #2c3e50;
}

.picker-arrow {
  color: #bdc3c7;
  font-size: 24rpx;
}

.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.input-item {
  margin-bottom: 20rpx;
}

.input-label {
  font-size: 28rpx;
  color: #2c3e50;
  margin-bottom: 10rpx;
  display: block;
}

.input-field {
  border: 1rpx solid #ecf0f1;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 30rpx;
  color: #2c3e50;
  background: #f5f6fa;
}

.calc-btn {
  background: #2c3e50;
  color: #fff;
  text-align: center;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.calc-btn.loading {
  background: #bdc3c7;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #ecf0f1;
  padding-bottom: 16rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.result-row:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 28rpx;
  color: #7f8c8d;
}

.result-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.assumptions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.assumption-item {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-top: 4rpx;
}

.judgment-badge {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.judgment-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chart-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  border-bottom: 2rpx solid #ecf0f1;
  padding-bottom: 16rpx;
}

.valuation-chart {
  width: 100%;
  height: 400rpx;
}

.footer-link {
  text-align: center;
  margin-top: 20rpx;
  padding: 24rpx;
  color: #2c3e50;
  font-size: 28rpx;
}
