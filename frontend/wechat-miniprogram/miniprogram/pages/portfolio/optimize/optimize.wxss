.container { padding: 24rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #2c3e50; }
.subtitle { font-size: 26rpx; color: #7f8c8d; }
.consent-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.consent-label { display: flex; align-items: flex-start; font-size: 28rpx; color: #2c3e50; }
.consent-label checkbox { margin-right: 12rpx; }
.btn-primary { background: #2c3e50; color: #fff; border-radius: 12rpx; height: 88rpx; line-height: 88rpx; margin-top: 24rpx; }
.loading { text-align: center; padding: 40rpx; color: #7f8c8d; }
.error { text-align: center; padding: 40rpx; color: #e74c3c; }
.section { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.summary-text { font-size: 28rpx; color: #2c3e50; line-height: 1.6; }
.suggestion { margin-bottom: 24rpx; }
.suggestion-title { font-size: 28rpx; font-weight: bold; color: #2c3e50; display: block; }
.suggestion-desc { font-size: 26rpx; color: #7f8c8d; }
