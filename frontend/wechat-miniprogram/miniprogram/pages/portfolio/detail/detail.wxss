.container { padding: 20rpx; background: #f5f6fa; min-height: 100vh; }
.header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0 32rpx; }
.header-main { flex: 1; }
.title { font-size: 40rpx; font-weight: bold; color: #2c3e50; display: block; }
.subtitle { font-size: 24rpx; color: #7f8c8d; margin-top: 8rpx; display: block; }
.edit-link { font-size: 28rpx; color: #2c3e50; padding: 12rpx 20rpx; border: 2rpx solid #2c3e50; border-radius: 8rpx; }
.summary { display: flex; justify-content: space-around; background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.metric { text-align: center; }
.metric .label { font-size: 24rpx; color: #7f8c8d; display: block; }
.metric .value { font-size: 32rpx; font-weight: bold; display: block; margin-top: 4rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.btn { flex: 1; min-width: 140rpx; background: #2c3e50; color: #fff; font-size: 26rpx; padding: 12rpx; border-radius: 8rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #2c3e50; margin-bottom: 12rpx; }
.holding-row { display: flex; justify-content: space-between; align-items: center; background: #fff; padding: 20rpx; border-radius: 8rpx; margin-bottom: 8rpx; }
.holding-info { flex: 1; min-width: 0; }
.symbol { font-size: 30rpx; font-weight: bold; color: #2c3e50; display: block; }
.name { font-size: 24rpx; color: #7f8c8d; display: block; }
.holding-values { text-align: right; margin-right: 16rpx; }
.market { font-size: 28rpx; font-weight: bold; color: #2c3e50; display: block; }
.pnl { font-size: 24rpx; display: block; }
.holding-actions { display: flex; flex-direction: column; gap: 12rpx; }
.action-btn { font-size: 24rpx; color: #2c3e50; padding: 8rpx 16rpx; border: 2rpx solid #2c3e50; border-radius: 8rpx; text-align: center; }
.action-btn.delete { color: #e74c3c; border-color: #e74c3c; }
.danger-zone { margin-top: 40rpx; }
.danger-btn { background: #e74c3c; color: #fff; font-size: 30rpx; height: 88rpx; border-radius: 12rpx; }
