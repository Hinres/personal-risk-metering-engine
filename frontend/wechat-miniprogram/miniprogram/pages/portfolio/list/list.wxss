.container { padding: 20rpx; background: #f5f6fa; min-height: 100vh; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.header-actions { display: flex; align-items: center; gap: 16rpx; }
.btn-text { background: transparent; color: #2c3e50; font-size: 28rpx; padding: 10rpx 16rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #2c3e50; }
.btn-add { background: #2c3e50; color: #fff; font-size: 28rpx; padding: 10rpx 24rpx; border-radius: 8rpx; }
.list { height: calc(100vh - 120rpx); }
.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.name { font-size: 32rpx; font-weight: bold; color: #2c3e50; }
.type { font-size: 24rpx; color: #7f8c8d; background: #ecf0f1; padding: 4rpx 12rpx; border-radius: 8rpx; }
.card-body { display: flex; justify-content: space-between; }
.metric { text-align: center; flex: 1; }
.metric .label { font-size: 24rpx; color: #7f8c8d; display: block; }
.metric .value { font-size: 28rpx; font-weight: bold; color: #2c3e50; display: block; margin-top: 4rpx; }
.menu-btn { padding: 8rpx 16rpx; margin: -8rpx -16rpx -8rpx 16rpx; }
.menu-dots { font-size: 36rpx; color: #7f8c8d; font-weight: bold; }
