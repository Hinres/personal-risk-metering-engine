.container { padding: 24rpx; }
.header { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #2c3e50; }
.subtitle { font-size: 26rpx; color: #7f8c8d; }
.form-card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 24rpx; }
.form-row { margin-bottom: 24rpx; }
.label { font-size: 28rpx; color: #2c3e50; display: block; margin-bottom: 12rpx; }
.input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; }
.btn-primary { background: #2c3e50; color: #fff; border-radius: 12rpx; height: 88rpx; line-height: 88rpx; }
