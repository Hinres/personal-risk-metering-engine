# 应用配置（UAT 环境）
NODE_ENV=uat
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# ── 数据库配置（P1-6 双模式支持） ──
# DB_TYPE: sqlite | postgres
DB_TYPE=sqlite

# SQLite 配置（UAT 默认，部署时按需切 PostgreSQL）
SQLITE_DB_PATH=./data/database.sqlite

# PostgreSQL 配置（生产/UAT 可选）
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=prme_user
# DB_PASSWORD=prme_password
# DB_NAME=prme_db
# DB_SCHEMA=public
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# 缓存配置（v1.2 使用 SQLite + 内存缓存，Redis 已移除）

# JWT配置 —— UAT 环境必须修改！
JWT_SECRET=change-me-in-uat
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 加密密钥 —— UAT 环境必须修改！
ENCRYPTION_KEY=change-me-in-uat-32-char-key!!

# UAT 环境必须关闭优化建议授权跳过，以验证 consent 阻断逻辑（ISS-003）
OPTIMIZATION_CONSENT_SKIP=false

# 计算引擎
CALC_ENGINE_URL=http://localhost:8000

# 微信配置 —— UAT 环境必须修改！
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_DIR=/tmp/prme-logs-uat

# 邮件/通知
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 文件上传
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Tushare API —— UAT 环境可选；不配置时自动启用 mock 行情数据（ISS-001）
TUSHARE_TOKEN=
