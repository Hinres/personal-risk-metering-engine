# PRME 环境变量示例
# 复制本文件为 .env 后按实际环境修改
# 注意：不要将真实 .env 提交到 Git

# ============================================================
# 1. 后端 API 服务配置
# ============================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# 日志配置
LOG_LEVEL=info
LOG_DIR=./logs

# ============================================================
# 2. 数据库配置（双模式：sqlite / postgres）
# ============================================================
# 开发/测试默认使用 SQLite，生产可切换为 PostgreSQL
DB_TYPE=sqlite

# --- SQLite 配置 ---
SQLITE_DB_PATH=./data/database.sqlite

# --- PostgreSQL 配置（生产环境使用）---
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=prme_user
# DB_PASSWORD=change-me-in-production
# DB_NAME=prme_db
# DB_SCHEMA=public
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# ============================================================
# 3. JWT 认证（生产环境必须修改！）
# ============================================================
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# 4. 微信小程序（如需接入微信登录）
# ============================================================
WECHAT_APPID=your-app-id
WECHAT_APPSECRET=your-app-secret

# ============================================================
# 5. 市场数据源
# ============================================================
# Tushare token，从 https://tushare.pro 注册获取
TUSHARE_TOKEN=your-tushare-token

# ============================================================
# 6. 计算引擎（独立模式）
# ============================================================
# 默认后端使用内嵌计算引擎；如需独立 Python 服务，修改此处
CALC_ENGINE_URL=http://localhost:8000

# ============================================================
# 7. Web 管理后台（frontend/web-admin）
# ============================================================
# Vite 开发环境代理目标
VITE_API_BASE_URL=http://localhost:3000/api/v1
