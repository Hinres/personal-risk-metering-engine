NODE_ENV=development
PORT=3000
API_PREFIX=/api

# ── 数据库配置（P1-6 双模式支持） ──
# DB_TYPE: sqlite | postgres
DB_TYPE=sqlite

# SQLite 配置（开发/测试默认）
SQLITE_DB_PATH=./data/database.sqlite

# PostgreSQL 配置（生产环境使用）
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=prme_user
# DB_PASSWORD=prme_password
# DB_NAME=prme_db
# DB_SCHEMA=public
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# JWT
JWT_SECRET=***
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 微信小程序
WECHAT_APPID=your-app-id
WECHAT_APPSECRET=***

# Tushare API
TUSHARE_TOKEN=your-t…here

# 计算引擎
CALC_ENGINE_URL=http://localhost:8000
